{
  "name": "realitka-ai-monorepo",
  "private": true,
  "workspaces": [
    "apps/crm",
    "apps/marketing",
    "packages/mcp-shared",
    "packages/mcp-crm",
    "packages/mcp-comm",
    "packages/mcp-calendar",
    "packages/mcp-telephony",
    "packages/mcp-onlinovo"
  ],
  "scripts": {
    "bus": "node scripts/bus/cli.ts",
    "bus:serve": "node scripts/bus/serve.ts",
    "bus:validate": "node scripts/bus/cli.ts validate",
    "bus:handshake": "node scripts/bus/handshake.ts",
    "bus:consume": "node scripts/bus/consume.ts",
    "bus:test": "node --test packages/bus-core/tests/*.test.ts scripts/bus/__tests__/*.test.ts",
    "bus:typecheck": "tsc -p packages/bus-core/tsconfig.json --noEmit",
    "prospect:enrich": "npx tsx scripts/prospecting/enrich.ts",
    "brain:ingest": "tsx brain/src/ingest.ts",
    "brain:check": "tsx brain/src/ingest.ts --check",
    "brain:audit": "tsx brain/src/audit.ts",
    "brain:weekly": "tsx brain/src/weekly.ts",
    "brain:test": "tsx --test brain/tests/*.test.ts",
    "brain:typecheck": "tsc -p brain/tsconfig.json --noEmit",
    "prospect:score": "npx tsx scripts/prospecting/score.ts",
    "prospect:export": "npx tsx scripts/prospecting/export.ts",
    "prospect:test": "npm run test --prefix apps/crm -- --config ../../scripts/prospecting/vitest.config.ts",
    "seed:test-campaigns": "npx tsx scripts/seed-test-campaigns.ts",
    "control-contract:test": "node --test packages/control-contract/tests/*.test.ts",
    "control-contract:typecheck": "tsc -p packages/control-contract/tsconfig.json --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
