# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Backup files — never commit secrets
backups/
*.bak
*.env.local.bak

# dependencies
/node_modules
# `/node_modules` is root-anchored, so the dev-only tooling that the
# control-contract and bus CI jobs install per package was not ignored. Anyone
# running those typechecks locally would otherwise be one `git add -A` away
# from committing it.
packages/*/node_modules/
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Local / agent noise (do not commit) ---
.claude-flow/
.claude/skills/
**/__pycache__/
apps/crm/error-capture.log
.swarm/*.json
apps/crm/supabase/.temp/
apps/crm/tmp-*.json
tmp-*.md
apps/crm/design-handoff-zips/
