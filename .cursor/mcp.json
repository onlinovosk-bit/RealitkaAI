{
  "mcpServers": {
    "ruflo": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "CLAUDE_FLOW_CWD": "${workspaceFolder}"
      }
    },
    "onlinovo": {
      "type": "stdio",
      "command": "npm",
      "args": [
        "--prefix",
        "${workspaceFolder}",
        "run",
        "--silent",
        "mcp:onlinovo"
      ],
      "env": {
        "ONLINOVO_SHOP_ADAPTER": "fixture"
      }
    }
  }
}
